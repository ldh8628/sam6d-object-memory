+    def _setup_sam_subscription(self) -> None:
+        msg_type = str(self.get_parameter("sam6d.pose_msg_type").value)
+        if msg_type == "pose_array":
+            topic = str(self.get_parameter("sam6d.pose_array_topic").value)
+            self.create_subscription(PoseArray, topic, self._on_sam_pose_array, 10)
+        else:
+            topic = str(self.get_parameter("sam6d.pose_topic").value)
+            self.create_subscription(TransformStamped, topic, self._on_sam_transform, 10)
+        self.get_logger().info(f"subscribing SAM-6D raw pose: {topic} ({msg_type})")
+
+    def _setup_optional_score_subscription(self) -> None:
+        topic = str(self.get_parameter("sam6d.score_topic").value)
+        if topic:
+            self.create_subscription(Float32, topic, self._on_score, 10)
+
+    def _setup_branches(self) -> None:
+        for name in ("orbslam3", "hdl_graph_slam", "rtabmap"):
+            cfg = BranchConfig(
+                name=name,
+                enabled=bool(self.get_parameter(f"{name}.enabled").value),
+                source_kind=str(self.get_parameter(f"{name}.source_kind").value),
+                pose_topic=str(self.get_parameter(f"{name}.pose_topic").value),
+                pose_msg_type=str(self.get_parameter(f"{name}.pose_msg_type").value),
+                output_topic=str(self.get_parameter(f"{name}.output_topic").value),
+                world_frame=str(self.get_parameter(f"{name}.world_frame").value),
+                camera_frame=str(self.get_parameter(f"{name}.camera_frame").value),
+                base_frame=str(self.get_parameter(f"{name}.base_frame").value),
+            )
+            state = BranchState(cfg)
+            state.publisher = self.create_publisher(PoseStamped, cfg.output_topic, 10)
+            hold_topic = cfg.output_topic.rstrip("/") + "_simple_hold_debug"
+            state.hold_publisher = self.create_publisher(PoseStamped, hold_topic, 10)
+            self.branches[name] = state
+            self.branch_metrics[name] = Metrics()
+            self.hold_metrics[name] = Metrics()
+            if not cfg.enabled:
+                continue
+            self._subscribe_branch_pose(state)
+            status_topic = str(self.get_parameter(f"{name}.tracking_state_topic").value)
+            if status_topic:
+                self.create_subscription(
+                    String,
+                    status_topic,
+                    lambda msg, branch=name: self._on_branch_status(branch, msg),
+                    10,
+                )
+
+    def _subscribe_branch_pose(self, state: BranchState) -> None:
+        cfg = state.config
+        callback: Callable
+        if cfg.pose_msg_type == "odometry":
+            callback = lambda msg, branch=cfg.name: self._on_slam_odometry(branch, msg)
+            self.create_subscription(Odometry, cfg.pose_topic, callback, 10)
+        elif cfg.pose_msg_type == "pose_with_covariance_stamped":
+            callback = lambda msg, branch=cfg.name: self._on_slam_pose_with_covariance(branch, msg)
+            self.create_subscription(PoseWithCovarianceStamped, cfg.pose_topic, callback, 10)
+        elif cfg.pose_msg_type == "transform_stamped":
+            callback = lambda msg, branch=cfg.name: self._on_slam_transform(branch, msg)
+            self.create_subscription(TransformStamped, cfg.pose_topic, callback, 10)
+        else:
+            callback = lambda msg, branch=cfg.name: self._on_slam_pose_stamped(branch, msg)
+            self.create_subscription(PoseStamped, cfg.pose_topic, callback, 10)
+        self.get_logger().info(
+            f"subscribing {cfg.name}: {cfg.pose_topic} ({cfg.pose_msg_type}, {cfg.source_kind})"
+        )
+
+    def _on_score(self, msg: Float32) -> None:
+        self.sam_score = float(msg.data)
+
+    def _on_branch_status(self, branch: str, msg: String) -> None:
+        self.branches[branch].latest_status = msg.data
+
+    def _on_slam_pose_stamped(self, branch: str, msg: PoseStamped) -> None:
+        stamp_sec, valid_stamp = self._stamp_info(msg.header.stamp)
+        frame_id = msg.header.frame_id or self.branches[branch].config.world_frame
+        try:
+            pose = pose_from_msg(msg.pose)
+        except ValueError as exc:
+            self.branches[branch].latest_pose = None
+            self.branches[branch].latest_status = str(exc)
+            return
+        self.branches[branch].latest_pose = PoseSample(pose, stamp_sec, msg.header.stamp, frame_id, valid_stamp=valid_stamp)
+
+    def _on_slam_odometry(self, branch: str, msg: Odometry) -> None:
+        stamp_sec, valid_stamp = self._stamp_info(msg.header.stamp)
+        try:
+            pose = pose_from_msg(msg.pose.pose)
+        except ValueError as exc:
+            self.branches[branch].latest_pose = None
+            self.branches[branch].latest_status = str(exc)
+            return
+        self.branches[branch].latest_pose = PoseSample(
+            pose,
+            stamp_sec,
+            msg.header.stamp,
+            msg.header.frame_id or self.branches[branch].config.world_frame,
+            msg.child_frame_id,
+            valid_stamp=valid_stamp,
+        )
+
+    def _on_slam_pose_with_covariance(self, branch: str, msg: PoseWithCovarianceStamped) -> None:
+        stamp_sec, valid_stamp = self._stamp_info(msg.header.stamp)
+        frame_id = msg.header.frame_id or self.branches[branch].config.world_frame
+        try:
+            pose = pose_from_msg(msg.pose.pose)
+        except ValueError as exc:
+            self.branches[branch].latest_pose = None
+            self.branches[branch].latest_status = str(exc)
+            return
+        self.branches[branch].latest_pose = PoseSample(pose, stamp_sec, msg.header.stamp, frame_id, valid_stamp=valid_stamp)
+
+    def _on_slam_transform(self, branch: str, msg: TransformStamped) -> None:
+        stamp_sec, valid_stamp = self._stamp_info(msg.header.stamp)
+        try:
+            pose = pose_from_transform_msg(msg)
+        except ValueError as exc:
+            self.branches[branch].latest_pose = None
+            self.branches[branch].latest_status = str(exc)
+            return
+        self.branches[branch].latest_pose = PoseSample(
+            pose,
+            stamp_sec,
+            msg.header.stamp,
+            msg.header.frame_id,
+            msg.child_frame_id,
+            valid_stamp=valid_stamp,
+        )
+
+    def _on_sam_transform(self, msg: TransformStamped) -> None:
+        stamp_sec, valid_stamp = self._stamp_info(msg.header.stamp)
+        try:
+            pose = pose_from_transform_msg(msg)
+        except ValueError as exc:
+            self._process_missing_sam(msg.header.stamp, msg.header.frame_id or self.sam_camera_frame, str(exc))
+            return
+        self.latest_sam = PoseSample(
+            pose,
+            stamp_sec,
+            msg.header.stamp,
+            msg.header.frame_id or self.sam_camera_frame,
+            msg.child_frame_id,
+            self.sam_score,
+            valid_stamp,
+        )
+        self._process_sam_sample()
+
+    def _on_sam_pose_array(self, msg: PoseArray) -> None:
+        index = int(self.get_parameter("sam6d.pose_array_index").value)
+        if index < 0 or index >= len(msg.poses):
+            self.latest_sam = None
+            self._process_missing_sam(
+                msg.header.stamp,
+                msg.header.frame_id or self.sam_camera_frame,
+                "missing_sam_pose",
+            )
+            return
+        stamp_sec, valid_stamp = self._stamp_info(msg.header.stamp)
+        try:
+            pose = pose_from_msg(msg.poses[index])
+        except ValueError as exc:
+            self._process_missing_sam(msg.header.stamp, msg.header.frame_id or self.sam_camera_frame, str(exc))
+            return
+        self.latest_sam = PoseSample(
+            pose,
+            stamp_sec,
+            msg.header.stamp,
+            msg.header.frame_id or self.sam_camera_frame,
+            f"sam6d_object_{index}",
+            self.sam_score,
+            valid_stamp,
+        )
+        self._process_sam_sample()
+
+    def _stamp_info(self, stamp) -> tuple[float, bool]:
+        stamp_sec = stamp_to_sec(stamp)
+        if stamp_sec <= 0.0:
+            return self._now_sec(), False
+        return stamp_sec, True
+
+    def _process_missing_sam(self, stamp, frame_id: str, reason: str) -> None:
+        stamp_sec, _ = self._stamp_info(stamp)
+        base_row = {
+            "timestamp": f"{stamp_sec:.9f}",
+            "frame_id": frame_id,
+            "sam6d_has_pose": False,
+            "sam6d_score": self._fmt(self.sam_score),
+            "slam_source": "raw",
+            "slam_has_pose": False,
+            "tf_chain_valid": False,
+            "raw_tx": "",
+            "raw_ty": "",
+            "raw_tz": "",
+            "raw_qx": "",
+            "raw_qy": "",
+            "raw_qz": "",
+            "raw_qw": "",
+            "world_tx": "",
+            "world_ty": "",
+            "world_tz": "",
+            "world_qx": "",
+            "world_qy": "",
+            "world_qz": "",
+            "world_qw": "",
+            "raw_delta_t_mm": "",
+            "raw_delta_r_deg": "",
+            "world_delta_t_mm": "",
+            "world_delta_r_deg": "",
+            "fusion_valid": False,
+            "failure_reason": reason,
+        }
+        self.csv_writer.writerow(base_row)
+        for name, state in self.branches.items():
+            row = dict(base_row)
+            row["slam_source"] = name
+            row["slam_has_pose"] = state.latest_pose is not None
+            row["failure_reason"] = reason
+            self.csv_writer.writerow(row)
+            state.invalid_frames += 1
+        self.csv_file.flush()
+        self._publish_debug_metrics()
+
+    def _process_sam_sample(self) -> None:
+        start = time.perf_counter()
+        sam = self.latest_sam
+        if sam is None:
+            return
+        raw_dt, raw_dr = self.raw_metrics.add(sam.pose)
+        self.raw_debug_pub.publish(
+            pose_to_transform_stamped(
+                sam.pose,
+                sam.frame_id,
+                sam.child_frame_id or "sam6d_object",
+                sam.stamp_msg,
+            )
+        )
+        self._write_csv_row(
+            sam=sam,
+            slam_source="raw",
+            slam_has_pose=False,
+            tf_chain_valid=False,
+            raw_delta_t_mm=raw_dt,
+            raw_delta_r_deg=raw_dr,
+            world_pose=None,
+            world_delta_t_mm=math.nan,
+            world_delta_r_deg=math.nan,
+            fusion_valid=False,
+            failure_reason="raw_camera_frame_only",
+        )
+        for state in self.branches.values():
+            self._process_branch(state, sam, raw_dt, raw_dr)
+        self.csv_file.flush()
+        self.processing_ms.append((time.perf_counter() - start) * 1000.0)
+        if len(self.processing_ms) > 1000:
+            self.processing_ms = self.processing_ms[-1000:]
+        self._publish_debug_metrics()
+
+    def _process_branch(
+        self,
+        state: BranchState,
+        sam: PoseSample,
+        raw_dt: float,
+        raw_dr: float,
+    ) -> None:
+        cfg = state.config
+        if not cfg.enabled:
+            return
+        world_pose, valid, tf_valid, reason = self._compute_fusion(state, sam)
+        if not valid or world_pose is None:
+            state.invalid_frames += 1
+            self._write_csv_row(
+                sam,
+                cfg.name,
+                state.latest_pose is not None,
+                tf_valid,
+                raw_dt,
+                raw_dr,
+                None,
+                math.nan,
+                math.nan,
+                False,
+                reason,
+            )
+            return
+        state.valid_frames += 1
+        world_dt, world_dr = self.branch_metrics[cfg.name].add(world_pose)
+        state.previous_world = world_pose
+        if state.publisher is not None:
+            state.publisher.publish(pose_to_pose_stamped(world_pose, cfg.world_frame, sam.stamp_msg))
+        self._write_csv_row(
+            sam,
+            cfg.name,
+            True,
+            tf_valid,
+            raw_dt,
+            raw_dr,
+            world_pose,
+            world_dt,
+            world_dr,
+            True,
+            "",
+        )
+        hold_pose = self._simple_hold_pose(state, world_pose, world_dt, world_dr)
+        hold_dt, hold_dr = self.hold_metrics[cfg.name].add(hold_pose)
+        if state.hold_publisher is not None:
+            state.hold_publisher.publish(pose_to_pose_stamped(hold_pose, cfg.world_frame, sam.stamp_msg))
+        self._write_csv_row(
+            sam,
+            f"{cfg.name}_simple_hold",
+            True,
+            tf_valid,
+            raw_dt,
+            raw_dr,
+            hold_pose,
+            hold_dt,
+            hold_dr,
+            True,
+            "shadow_hold_only" if hold_pose is not world_pose else "",
+        )
+
+    def _compute_fusion(
+        self,
+        state: BranchState,
+        sam: PoseSample,
+    ) -> tuple[TfPose | None, bool, bool, str]:
+        cfg = state.config
+        slam = state.latest_pose
+        if slam is None:
+            return None, False, False, "missing_slam_pose"
+        if not sam.valid_stamp:
+            return None, False, False, "invalid_sam_timestamp"
+        if not slam.valid_stamp:
+            return None, False, False, "invalid_slam_timestamp"
+        if cfg.world_frame and slam.frame_id and slam.frame_id != cfg.world_frame:
+            return None, False, False, f"slam_world_frame_mismatch:{slam.frame_id}!={cfg.world_frame}"
+        age = abs(sam.stamp_sec - slam.stamp_sec)
+        if age > self.pose_stale_sec:
+            return None, False, False, f"stale_slam_pose:{age:.3f}s"
+        if cfg.source_kind == "camera":
+            world_t_camera = slam.pose
+            if cfg.camera_frame and cfg.camera_frame != sam.frame_id:
+                extra, ok, reason = self._lookup_tf_pose(cfg.camera_frame, sam.frame_id, sam)
+                if not ok or extra is None:
+                    return None, False, False, reason
+                world_t_camera = world_t_camera.compose(extra)
+            return world_t_camera.compose(sam.pose), True, True, ""
+        if cfg.source_kind == "base":
+            base_frame = slam.child_frame_id or cfg.base_frame
+            if not base_frame:
+                return None, False, False, "base_frame_unknown"
+            base_t_camera, ok, reason = self._lookup_tf_pose(base_frame, sam.frame_id, sam)
+            if not ok or base_t_camera is None:
+                return None, False, False, f"not_evaluable_missing_T_BC:{reason}"
+            return slam.pose.compose(base_t_camera).compose(sam.pose), True, True, ""
+        return None, False, False, f"unsupported_source_kind:{cfg.source_kind}"
+
+    def _lookup_tf_pose(
+        self,
+        target_frame: str,
+        source_frame: str,
+        sam: PoseSample,
+    ) -> tuple[TfPose | None, bool, str]:
+        if target_frame == source_frame:
+            return TfPose.identity(), True, ""
+        try:
+            lookup_time = Time.from_msg(sam.stamp_msg) if sam.stamp_sec > 0.0 else Time()
+            tf_msg = self.tf_buffer.lookup_transform(target_frame, source_frame, lookup_time)
+            return pose_from_transform_msg(tf_msg), True, ""
+        except Exception as exc:  # tf2 exception classes vary by distro.
+            return None, False, str(exc).replace("\n", " ")
+
+    def _simple_hold_pose(
+        self,
+        state: BranchState,
+        world_pose: TfPose,
+        world_dt: float,
+        world_dr: float,
+    ) -> TfPose:
+        if not self.simple_hold_enabled:
+            state.previous_hold = world_pose
+            return world_pose
+        previous = state.previous_hold
+        if previous is None:
+            state.previous_hold = world_pose
+            return world_pose
+        jump = (
+            (not math.isnan(world_dt) and world_dt > self.simple_hold_max_delta_t_mm)
+            or (not math.isnan(world_dr) and world_dr > self.simple_hold_max_delta_r_deg)
+        )
+        if jump and state.hold_count < self.simple_hold_frames:
+            state.hold_count += 1
+            return previous
+        state.hold_count = 0
+        state.previous_hold = world_pose
+        return world_pose
+
+    def _write_csv_row(
+        self,
+        sam: PoseSample,
+        slam_source: str,
+        slam_has_pose: bool,
+        tf_chain_valid: bool,
+        raw_delta_t_mm: float,
+        raw_delta_r_deg: float,
+        world_pose: TfPose | None,
+        world_delta_t_mm: float,
+        world_delta_r_deg: float,
+        fusion_valid: bool,
+        failure_reason: str,
+    ) -> None:
+        raw = sam.pose
+        row = {
+            "timestamp": f"{sam.stamp_sec:.9f}",
+            "frame_id": sam.frame_id,
+            "sam6d_has_pose": True,
+            "sam6d_score": self._fmt(sam.score),
+            "slam_source": slam_source,
+            "slam_has_pose": slam_has_pose,
+            "tf_chain_valid": tf_chain_valid,
+            "raw_tx": self._fmt(raw.t[0]),
+            "raw_ty": self._fmt(raw.t[1]),
+            "raw_tz": self._fmt(raw.t[2]),
+            "raw_qx": self._fmt(raw.q[0]),
+            "raw_qy": self._fmt(raw.q[1]),
+            "raw_qz": self._fmt(raw.q[2]),
+            "raw_qw": self._fmt(raw.q[3]),
+            "world_tx": "",
+            "world_ty": "",
+            "world_tz": "",
+            "world_qx": "",
+            "world_qy": "",
+            "world_qz": "",
+            "world_qw": "",
+            "raw_delta_t_mm": self._fmt(raw_delta_t_mm),
+            "raw_delta_r_deg": self._fmt(raw_delta_r_deg),
+            "world_delta_t_mm": self._fmt(world_delta_t_mm),
+            "world_delta_r_deg": self._fmt(world_delta_r_deg),
+            "fusion_valid": fusion_valid,
+            "failure_reason": failure_reason,
+        }
+        if world_pose is not None:
+            row.update(
+                {
+                    "world_tx": self._fmt(world_pose.t[0]),
+                    "world_ty": self._fmt(world_pose.t[1]),
+                    "world_tz": self._fmt(world_pose.t[2]),
+                    "world_qx": self._fmt(world_pose.q[0]),
+                    "world_qy": self._fmt(world_pose.q[1]),
+                    "world_qz": self._fmt(world_pose.q[2]),
+                    "world_qw": self._fmt(world_pose.q[3]),
+                }
+            )
+        self.csv_writer.writerow(row)
+
+    def _publish_debug_metrics(self) -> None:
+        payload = {
+            "raw_frames": len(self.raw_metrics.samples),
+            "csv_path": str(self.csv_path),
+            "report_path": str(self.report_path),
+            "branches": {
+                name: {
+                    "valid_frames": state.valid_frames,
+                    "invalid_frames": state.invalid_frames,
+                    "latest_status": state.latest_status,
+                    "latest_pose_age_sec": self._latest_pose_age(state),
+                }
+                for name, state in self.branches.items()
+            },
+        }
+        msg = String()
+        msg.data = json.dumps(payload, sort_keys=True)
+        self.debug_metrics_pub.publish(msg)
+
+    def _latest_pose_age(self, state: BranchState) -> float | None:
+        if state.latest_pose is None or self.latest_sam is None:
+            return None
+        return abs(self.latest_sam.stamp_sec - state.latest_pose.stamp_sec)
+
+    def write_topic_discovery(self) -> None:
+        topics = dict(self.get_topic_names_and_types())
+        candidates = {
+            "sam6d": [
+                str(self.get_parameter("sam6d.pose_topic").value),
+                str(self.get_parameter("sam6d.pose_array_topic").value),
+            ],
+            "orbslam3": ["/orbslam3/pose", "/orbslam3/odom", "/tf", "/orbslam3/tracking_state"],
+            "hdl_graph_slam": [
+                "/odom",
+                "/scan_matching_odometry/transform",
+                "/tf",
+                "/scan_matching_odometry/status",
+            ],
+            "rtabmap": ["/rtabmap/pose", "/odom", "/tf", "/rtabmap/localization_pose"],
+        }
+        result = {}
+        for system, names in candidates.items():
+            result[system] = {
+                name: {
+                    "present": name in topics,
+                    "types": topics.get(name, []),
+                }
+                for name in names
+            }
+        self.discovery_path.write_text(json.dumps(result, indent=2, sort_keys=True), encoding="utf-8")
+
+    def write_report(self) -> None:
+        raw_count = len(self.raw_metrics.samples)
+        mean_processing_ms = (
+            sum(self.processing_ms) / len(self.processing_ms) if self.processing_ms else math.nan
+        )
+        raw_std = self.raw_metrics.translation_std_mm()
+        rows = [self._report_row("SAM-6D raw T_CO", raw_count, self.raw_metrics, raw_std, raw_count)]
+        for name, state in self.branches.items():
+            label = self._display_name(name)
+            rows.append(
+                self._report_row(
+                    f"SAM-6D + {label} T_WO",
+                    state.valid_frames,
+                    self.branch_metrics[name],
+                    raw_std,
+                    raw_count,
+                )
+            )
+        for name, state in self.branches.items():
+            label = self._display_name(name)
+            rows.append(
+                self._report_row(
+                    f"SAM-6D + {label} + simple hold",
+                    len(self.hold_metrics[name].samples),
+                    self.hold_metrics[name],
+                    raw_std,
+                    raw_count,
+                )
+            )
+        fps_impact = self._fps_impact(mean_processing_ms)
+        text = [
+            "# SAM-6D SLAM Fusion Shadow Evaluation Report",
+            "",
+            f"- CSV: `{self.csv_path}`",
+            f"- Topic discovery: `{self.discovery_path}`",
+            f"- Raw frames: {raw_count}",
+            f"- Mean evaluator callback cost: {self._fmt(mean_processing_ms)} ms",
+            f"- FPS impact estimate: {fps_impact}",
+            "",
+            "| Condition | Valid Frames | Translation Std mm | Rotation Std deg | Delta T Mean mm | Delta R Mean deg | FPS Impact | Verdict |",
+            "|---|---:|---:|---:|---:|---:|---|---|",
+        ]
+        for row in rows:
+            text.append(
+                "| {condition} | {valid_frames} | {translation_std_mm} | {rotation_std_deg} | "
+                "{delta_t_mean_mm} | {delta_r_mean_deg} | {fps_impact} | {verdict} |".format(
+                    fps_impact=fps_impact,
+                    **row,
+                )
+            )
+        text.extend(self._decision_section(rows))
+        self.report_path.write_text("\n".join(text) + "\n", encoding="utf-8")
+
+    def _report_row(
+        self,
+        condition: str,
+        valid_frames: int,
+        metrics: Metrics,
+        raw_std: float,
+        raw_count: int,
+    ) -> dict[str, str]:
+        return {
+            "condition": condition,
+            "valid_frames": str(valid_frames),
+            "translation_std_mm": self._fmt(metrics.translation_std_mm()),
+            "rotation_std_deg": self._fmt(metrics.rotation_std_deg()),
+            "delta_t_mean_mm": self._fmt(metrics.delta_t_mean_mm()),
+            "delta_r_mean_deg": self._fmt(metrics.delta_r_mean_deg()),
+            "verdict": self._verdict(condition, valid_frames, metrics, raw_std, raw_count),
+        }
+
+    def _verdict(
+        self,
+        condition: str,
+        valid_frames: int,
+        metrics: Metrics,
+        raw_std: float,
+        raw_count: int,
+    ) -> str:
+        if condition == "SAM-6D raw T_CO":
+            return "BASELINE" if valid_frames >= 2 else "INSUFFICIENT_DATA"
+        cond_std = metrics.translation_std_mm()
+        if raw_count < 2 or valid_frames < 2 or math.isnan(raw_std) or raw_std <= 0.0:
+            return "INSUFFICIENT_DATA"
+        if math.isnan(cond_std):
+            return "INSUFFICIENT_DATA"
+        reduction = (raw_std - cond_std) / raw_std * 100.0
+        valid_ratio = valid_frames / max(raw_count, 1) * 100.0
+        fps_known = self.target_fps_baseline > 0.0
+        fps_ok = self._fps_impact_percent() <= 5.0 if fps_known else False
+        if reduction >= 30.0 and valid_ratio >= 90.0 and fps_ok:
+            return f"GO ({reduction:.1f}% reduction)"
+        if reduction >= 10.0 and valid_ratio >= 70.0:
+            suffix = ", fps unknown" if not fps_known else ""
+            return f"WEAK GO ({reduction:.1f}% reduction{suffix})"
+        return f"NO-GO ({reduction:.1f}% reduction)"
+
+    def _decision_section(self, rows: list[dict[str, str]]) -> list[str]:
+        lookup = {row["condition"]: row["verdict"] for row in rows}
+        return [
+            "",
+            "## Required Final Decision Questions",
+            "",
+            f"Q1. ORB-SLAM3 pose fusion reduced jitter? `{lookup.get('SAM-6D + ORB-SLAM3 T_WO', 'INSUFFICIENT_DATA')}`",
+            f"Q2. hdl_graph_slam pose fusion reduced jitter? `{lookup.get('SAM-6D + hdl_graph_slam T_WO', 'INSUFFICIENT_DATA')}`",
+            f"Q3. RTAB-Map pose fusion reduced jitter? `{lookup.get('SAM-6D + RTAB-Map T_WO', 'INSUFFICIENT_DATA')}`",
+            f"Q4. Highest product applicability? `{self._best_branch(rows)}`",
+            "Q5. Is SLAM fusion worth applying before One Euro Filter/EKF? `Only if this report shows GO/WEAK GO with valid TF/time sync; otherwise start with One Euro Filter/EKF.`",
+            "Q6. Next step? `Run the same static-object bag with SAM-6D plus one SLAM source active, then compare this report against the verdict thresholds.`",
+        ]
+
+    def _best_branch(self, rows: list[dict[str, str]]) -> str:
+        priority = ["RTAB-Map", "ORB-SLAM3", "hdl_graph_slam"]
+        candidates = [row for row in rows if "T_WO" in row["condition"] and "simple hold" not in row["condition"]]
+        go = [row for row in candidates if row["verdict"].startswith("GO")]
+        weak = [row for row in candidates if row["verdict"].startswith("WEAK GO")]
+        selected = go or weak
+        for name in priority:
+            if any(name in row["condition"] for row in selected):
+                return name
+        return "INSUFFICIENT_DATA"
+
+    def _fps_impact(self, mean_processing_ms: float) -> str:
+        if self.target_fps_baseline <= 0.0 or math.isnan(mean_processing_ms):
+            return "unknown"
+        return f"{self._fps_impact_percent():.2f}%"
+
+    def _fps_impact_percent(self) -> float:
+        if not self.processing_ms or self.target_fps_baseline <= 0.0:
+            return 0.0
+        mean_processing_ms = sum(self.processing_ms) / len(self.processing_ms)
+        frame_budget_ms = 1000.0 / self.target_fps_baseline
+        return mean_processing_ms / frame_budget_ms * 100.0
+
+    @staticmethod
+    def _display_name(name: str) -> str:
+        if name == "orbslam3":
+            return "ORB-SLAM3"
+        if name == "rtabmap":
+            return "RTAB-Map"
+        return "hdl_graph_slam"
+
+    @staticmethod
+    def _fmt(value: float) -> str:
+        if isinstance(value, bool):
+            return str(value)
+        if value is None or math.isnan(float(value)):
+            return ""
+        return f"{float(value):.6f}"
+
+    def _now_sec(self) -> float:
+        return self.get_clock().now().nanoseconds * 1e-9
+
+    def close(self) -> None:
+        try:
+            self.write_report()
+        except Exception as exc:
+            self._warn_if_context_ok(f"failed to write report during shutdown: {exc}")
+        if rclpy.ok():
+            try:
+                self.write_topic_discovery()
+            except Exception as exc:
+                self._warn_if_context_ok(f"failed to write topic discovery during shutdown: {exc}")
+        try:
+            self.csv_file.flush()
+            self.csv_file.close()
+        except Exception as exc:
+            self._warn_if_context_ok(f"failed to close csv during shutdown: {exc}")
+
+    def _warn_if_context_ok(self, message: str) -> None:
+        if rclpy.ok():
+            self.get_logger().warn(message)
+
+
+def main(args: list[str] | None = None) -> None:
+    rclpy.init(args=args)
+    node = Sam6dSlamFusionShadowEval()
+
+    def _raise_keyboard_interrupt(signum, frame) -> None:
+        raise KeyboardInterrupt
+
+    signal.signal(signal.SIGTERM, _raise_keyboard_interrupt)
+    try:
+        rclpy.spin(node)
+    except (KeyboardInterrupt, rclpy.executors.ExternalShutdownException):
+        pass
+    finally:
+        node.close()
+        node.destroy_node()
+        if rclpy.ok():
+            rclpy.shutdown()
+
+
+if __name__ == "__main__":
+    main()
