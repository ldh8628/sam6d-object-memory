# 대칭 선언(objectmemory core/fusion.py 의 보수적 표와 같다)
SYM_AXES = {"Sikhye_high": (0.0, 0.0, 1.0), "Sauce_high": (0.0, 0.0, 1.0),
            "Mugcup_high": (0.1057, 0.0337, 0.9938)}
SYM_STEP = 10


# ----------------------------------------------------------------- 회전 유틸
def _axis_rot(axis, deg):
    n = math.sqrt(sum(c * c for c in axis)) or 1.0
    x, y, z = (c / n for c in axis)
    a = math.radians(deg)
    c, s, k = math.cos(a), math.sin(a), 1.0 - math.cos(a)
    return np.array([[c + x * x * k, x * y * k - z * s, x * z * k + y * s],
                     [y * x * k + z * s, c + y * y * k, y * z * k - x * s],
                     [z * x * k - y * s, z * y * k + x * s, c + z * z * k]])


_SYM = {}


def sym_group(name):
    if name not in _SYM:
        ax = SYM_AXES.get(name)
        _SYM[name] = ([np.eye(3)] if ax is None else
                      [_axis_rot(ax, d) for d in range(0, 360, SYM_STEP)])
    return _SYM[name]


def ang_deg(A, B, name=None):
    """A 와 B 사이 각. 대칭이 선언되면 동치 자세 중 최소각(자세는 물체→카메라)."""
    best = 180.0
    for S in sym_group(name):
        tr = float(np.trace(A.T @ (B @ S)))
        best = min(best, math.degrees(math.acos(max(-1.0, min(1.0, (tr - 1.0) / 2.0)))))
    return best


def rot_mean(mats):
    """회전 평균(자세 행렬 합의 극분해). 같은 봉우리 안에서만 쓸 것."""
    M = sum(mats)
    u, _, vt = np.linalg.svd(M)
    R = u @ vt
    if np.linalg.det(R) < 0:
        u[:, -1] *= -1
        R = u @ vt
    return R


def mode_cluster(mats, tol, name=None):
    """최빈 군집의 (평균, 점유율). 상대회전 교정에 쓴다."""
    reps = []                      # [[대표, [원소...]], ...]
    for R in mats:
        for rep in reps:
            if ang_deg(rep[0], R, name) < tol:
                rep[1].append(R)
                rep[0] = rot_mean(rep[1])
                break
        else:
            reps.append([R.copy(), [R]])
    reps.sort(key=lambda r: -len(r[1]))
    return reps[0][0], len(reps[0][1]) / max(len(mats), 1)


# ----------------------------------------------------------------- bag 읽기
class FrameSyncError(RuntimeError):
    pass


def match_pending_rgbd(pending, depths, slop_ns):
    """Return matches, still-pending colors and colors proven unmatched."""
    matches, keep, dropped = [], [], []
    for color in pending:
        t = color[0]
        hit = min(depths, key=lambda d: abs(d[0] - t)) if depths else None
        if hit and abs(hit[0] - t) <= slop_ns:
            matches.append((color, hit))
        elif not depths or depths[-1][0] < t + slop_ns:
            keep.append(color)
        else:
            dropped.append(color)
    return matches, keep, dropped


def enforce_pending_bound(pending, max_pending):
    if len(pending) > max_pending:
        raise FrameSyncError(
            f"pending RGB queue exceeded {max_pending}; depth stream is missing or stalled")


def enforce_sync_complete(pending, dropped_unmatched=0):
    if dropped_unmatched:
        raise FrameSyncError(
            f"RGB-D synchronization dropped {dropped_unmatched} color frame(s)")
    if pending:
        raise FrameSyncError(
            f"RGB-D synchronization ended with {len(pending)} unmatched color frame(s); "
            f"first EOF stamp={pending[0][0]}")


def read_frames(bag, stride, limit, slop_ns=20_000_000, max_pending=64,
                expected_pair_count=None):
    from rosbags.highlevel import AnyReader
    from rosbags.typesys import Stores, get_typestore

    if isinstance(stride, bool) or int(stride) != stride or stride <= 0:
        raise FrameSyncError("stride must be a positive integer")
    if isinstance(limit, bool) or int(limit) != limit or limit < 0:
        raise FrameSyncError("limit must be a nonnegative integer")
    K, n_color = None, 0
    colors, depths, pairs = {}, {}, {}
    seen_colors, seen_depths, ignored_colors = set(), set(), set()
    typestore = get_typestore(Stores.ROS2_HUMBLE)
    with AnyReader([Path(bag)], default_typestore=typestore) as reader:
        connections = [connection for connection in reader.connections
                       if connection.topic in {CAMINFO, COLOR, DEPTH}]
        for connection, _bag_stamp, raw in reader.messages(connections=connections):
            message = reader.deserialize(raw, connection.msgtype)
            if connection.topic == CAMINFO and K is None:
                K = np.asarray(message.k, dtype=float).reshape(3, 3)
                continue
            stamp = (int(message.header.stamp.sec) * 1_000_000_000
                     + int(message.header.stamp.nanosec))
            if connection.topic == COLOR:
                if stamp in seen_colors:
                    raise FrameSyncError(f"duplicate RGB header stamp: {stamp}")
                seen_colors.add(stamp)
                n_color += 1
                if limit and len(pairs) >= limit:
                    ignored_colors.add(stamp)
                    depths.pop(stamp, None)
                    continue
                if (n_color - 1) % stride:
                    ignored_colors.add(stamp)
                    depths.pop(stamp, None)
                    continue
                array = np.frombuffer(message.data, np.uint8).reshape(
                    message.height, message.width, -1)
                colors[stamp] = (array.copy(), message.encoding)
            elif connection.topic == DEPTH:
                if stamp in seen_depths:
                    raise FrameSyncError(f"duplicate depth header stamp: {stamp}")
                seen_depths.add(stamp)
                if stamp in ignored_colors:
                    continue
                depths[stamp] = np.frombuffer(message.data, np.uint16).reshape(
                    message.height, message.width).copy()
            if stamp in colors and stamp in depths:
                array, encoding = colors.pop(stamp)
                depth = depths.pop(stamp)
                bgr = array[:, :, ::-1] if encoding == "rgb8" else array
                pairs[stamp] = (stamp, np.ascontiguousarray(bgr), depth)
            if len(colors) > max_pending:
                raise FrameSyncError(
                    f"pending RGB queue exceeded {max_pending}; depth stream is missing or stalled")
            if len(depths) > max_pending:
                raise FrameSyncError(
                    f"pending depth queue exceeded {max_pending}; RGB stream is missing or stalled")
            if limit and len(pairs) >= limit and K is not None:
                break
    frames = [pairs[stamp] for stamp in sorted(pairs)]
    if colors:
        first = min(colors)
        raise FrameSyncError(
            f"RGB-D synchronization ended with {len(colors)} unmatched color frame(s); "
            f"first EOF stamp={first}")
    if depths and not (limit and len(pairs) >= limit):
        first = min(depths)
        raise FrameSyncError(
            f"RGB-D synchronization ended with {len(depths)} unmatched depth frame(s); "
            f"first EOF stamp={first}")
    if expected_pair_count is not None:
        expected = (int(expected_pair_count) + stride - 1) // stride
        if limit:
            expected = min(expected, limit)
        if len(frames) != expected:
            raise FrameSyncError(
                f"validated dataset expected {expected} sampled RGB-D frames, got {len(frames)}")
    print(f"[bag] 컬러 {n_color} 중 {len(frames)} 프레임 사용 "
          f"(stride={stride}, unmatched=0, pending=0)")
    return K, frames


class DiagnosticReferenceProvider:
    """SLAM map pseudo-GT를 현재 카메라 좌표계 참조로 바꾼다."""

    def __init__(self, pseudo_gt_path, trajectory_path):
        from scipy.spatial.transform import Rotation
        try:
            raw_gt = json.loads(Path(pseudo_gt_path).read_text(encoding="utf-8"))
            self.gt = validate_trusted_reference_poses(raw_gt, str(pseudo_gt_path))
            self.reference_members = {
                (name, int(frame["stamp_ns"]))
                for name, value in raw_gt.items()
                if isinstance(value, dict) and value.get("trusted") is True
                for frame in value.get("reference_frames", [])
            }
        except (OSError, json.JSONDecodeError, DatasetValidationError) as exc:
            raise ValueError(f"invalid pseudo-GT {pseudo_gt_path}: {exc}") from exc
        arr = np.loadtxt(trajectory_path, ndmin=2)
        if arr.shape[1] != 8 or not np.isfinite(arr).all():
            raise ValueError(f"invalid trajectory: {trajectory_path}")
        if np.any(np.diff(arr[:, 0]) <= 0):
            raise ValueError(
                f"trajectory timestamps must be strictly increasing: {trajectory_path}")
        norms = np.linalg.norm(arr[:, 4:8], axis=1)
        if (np.any(norms < 1e-9)
                or not np.allclose(norms, 1.0, atol=1e-3, rtol=0.0)):
            raise ValueError(f"trajectory quaternions must be normalized: {trajectory_path}")
        self.times = arr[:, 0]
        self.poses = []
        for row in arr:
            T = np.eye(4)
            T[:3, :3] = Rotation.from_quat(row[4:8]).as_matrix()
            T[:3, 3] = row[1:4]
            self.poses.append(T)
        self.poses = np.asarray(self.poses)

    def at(self, stamp_ns, max_dt=0.025):
        stamp = stamp_ns / 1e9
        j = int(np.searchsorted(self.times, stamp))
        ids = [k for k in (j - 1, j) if 0 <= k < len(self.times)]
        if not ids:
            return {}
        k = min(ids, key=lambda q: abs(float(self.times[q] - stamp)))
        if abs(float(self.times[k] - stamp)) > max_dt:
            return {}
        inv_twc = np.linalg.inv(self.poses[k])
        refs = {}
        for name, gt in self.gt.items():
            if not isinstance(gt, dict) or gt.get("trusted") is not True:
                continue
            two = np.eye(4)
            two[:3, :3] = np.asarray(gt["R"], float)
            two[:3, 3] = np.asarray(gt["t_m"], float)
            tco = inv_twc @ two
            refs[name] = {"R": tco[:3, :3], "t_mm": tco[:3, 3] * 1000.0}
        return refs

    def is_reference_member(self, name, stamp_ns):
        return (str(name), int(stamp_ns)) in self.reference_members


# ----------------------------------------------------------------- 실행
def run(args):
    import torch
    from sam6d_core import Sam6DCore
    from verify_config import build_appe_cfg

    score_analysis_enabled = bool(getattr(args, "pem_score_analysis", False))
    try:
        validation = validate_rgbd_dataset(
            args.bag, args.dataset_manifest, require_manifest=True)
        enforce_ground_truth_policy(validation, args.pseudo_gt, args.trajectory)
        (args.rotation_threshold_deg,
         args.translation_threshold_mm) = validate_evaluation_thresholds(
             args.rotation_threshold_deg, args.translation_threshold_mm)
    except DatasetValidationError as exc:
        raise SystemExit(f"dataset validation failed: {exc}") from exc
    try:
        validated_reference_provider = (
            DiagnosticReferenceProvider(args.pseudo_gt, args.trajectory)
            if args.pseudo_gt and args.trajectory else None)
    except (OSError, ValueError) as exc:
        raise SystemExit(f"reference validation failed: {exc}") from exc
    if score_analysis_enabled and validated_reference_provider is None:
        raise SystemExit("--pem-score-analysis requires --pseudo-gt and --trajectory")
    print("[dataset] " + json.dumps(validation.summary(), ensure_ascii=False), flush=True)
    K, frames = read_frames(validation.bag, args.stride, args.limit,
                            expected_pair_count=validation.pair_count)
    if K is None or not frames:
        raise SystemExit("bag 에서 프레임/카메라 정보를 못 읽었다")
    out = Path(args.out)
    out.mkdir(parents=True, exist_ok=True)

    selected = None
    if args.select_rejections_from:
        selected = set()
        for line in open(args.select_rejections_from, encoding="utf-8"):
            row = json.loads(line)
            if any(x.get("input_rejection") for x in
                   (row.get("diagnostics") or {}).get("pem_candidates", [])):
                selected.add(int(row["i"]))
        print(f"[select] 기존 PEM 입력 탈락 프레임 {len(selected)}개만 재실행", flush=True)

    diagnostic_cfg = ({"enabled": True, "topn": args.pem_diagnostic_topn,
                       "evidence_stride": args.pem_diagnostic_stride,
                       "rotation_threshold_deg": args.rotation_threshold_deg,
                       "translation_threshold_mm": args.translation_threshold_mm,
                       "symmetry_axes": {k: list(v) for k, v in SYM_AXES.items()},
                       "sym_step_deg": SYM_STEP,
                       "score_analysis": {"enabled": score_analysis_enabled}}
                      if args.pem_diagnostic_topn > 0 or score_analysis_enabled else None)
    reference_provider = validated_reference_provider if diagnostic_cfg else None
    core = Sam6DCore(args.config, [], args.device, pem_diagnostic=diagnostic_cfg)
    for name in args.settings.split(","):
        rt = SETTINGS[name]
        ar, _ = build_appe_cfg(rt)
        if diagnostic_cfg:
            ar = dict(ar or {"topk": 100, "stride": 1})
            ar["diagnostic"] = diagnostic_cfg
        core.pem.cfg.appe_rerank = ar
        print(f"[run] {name}: {ar}", flush=True)
        detection_count = 0
        score_count = 0
        score_path = out / f"{name}.pem-score-analysis.jsonl"
        score_tmp_path = out / f".{name}.pem-score-analysis.jsonl.tmp"
        provenance_path = out / f"{name}.provenance.json"
        diagnostic_path = out / f"{name}.jsonl"
        diagnostic_tmp_path = out / f".{name}.jsonl.tmp"
        # A partial rerun must not leave an old provenance claiming that stale
        # score data is current. The score artifact itself is published only
        # by atomic replacement after inference completes.
        provenance_path.unlink(missing_ok=True)
        score_file = (score_tmp_path.open("w", encoding="utf-8")
                      if score_analysis_enabled else None)
        diagnostic_file = diagnostic_tmp_path.open("w", encoding="utf-8")
        frame_path = out / f"{name}_frames.jsonl"
        frame_file = frame_path.open("w", encoding="utf-8")
        run_frames = [(i, frame) for i, frame in enumerate(frames)
                      if selected is None or i in selected]
        for progress, (i, (t, bgr, dep)) in enumerate(run_frames):
            torch.manual_seed(SEED + i)
            np.random.seed(SEED + i)
            refs = reference_provider.at(t) if reference_provider else None
            det, ms, n_boxes, _ = core.process(
                bgr, dep, K, diagnostic_references=refs)
            for d in det:
                score_analysis = d.pop("score_analysis", None)
                if score_analysis_enabled and not score_analysis:
                    raise RuntimeError(
                        f"missing PEM score analysis for {d.get('object')} at {int(t)}")
                if score_analysis:
                    score_row = {
                        "schema_version": 1,
                        "stamp_ns": int(t), "frame_index": int(i),
                        "object": d["object"],
                        "reference_role": (
                            "reference_member" if reference_provider.is_reference_member(
                                d["object"], int(t)) else "evaluation_frame"),
                        **score_analysis,
                    }
                    score_file.write(json.dumps(
                        score_row, separators=(",", ":"), allow_nan=False) + "\n")
                    score_count += 1
                diagnostic_file.write(json.dumps(
                    {"stamp_ns": t, "i": i, **d}, separators=(",", ":"),
                    allow_nan=False) + "\n")
                detection_count += 1
            frame_file.write(json.dumps({
                "stamp_ns": t,
                "i": i,
                "n_boxes": n_boxes,
                "objects": [d["object"] for d in det],
                "ms": ms,
                "frame_sharpness": round(float(cv2.Laplacian(
                    cv2.cvtColor(bgr, cv2.COLOR_BGR2GRAY), cv2.CV_64F).var()), 2),
                "diagnostics": core.last_frame_diag,
            }, ensure_ascii=False) + "\n")
            if progress % 50 == 0:
                print(f"  {progress}/{len(run_frames)} (원본 {i})  "
                      f"누적검출 {detection_count}", flush=True)
        frame_file.close()
        diagnostic_file.flush()
        os.fsync(diagnostic_file.fileno())
        diagnostic_file.close()
        os.replace(diagnostic_tmp_path, diagnostic_path)
        if score_file is not None:
            score_file.flush()
            os.fsync(score_file.fileno())
            score_file.close()
            os.replace(score_tmp_path, score_path)
        output_directory_fd = os.open(args.out, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(output_directory_fd)
        finally:
            os.close(output_directory_fd)
        provenance = {
            "schema_version": 1,
            "kind": "SAM-6D diagnostic run",
            "dataset_id": validation.dataset_id,
            "optical_frame": validation.manifest["camera"]["optical_frame"],
            "dataset_snapshot": {
                "bag_database": validation.database.name,
                "bag_database_sha256": sha256(validation.database),
                "metadata_sha256": sha256(validation.bag / "metadata.yaml"),
            },
            "run": {
                "seed": SEED, "stride": args.stride, "limit": args.limit,
                "setting": name, "config": str(Path(args.config).resolve()),
                "config_sha256": sha256(args.config),
                "correctness": {
                    "rotation_threshold_deg": args.rotation_threshold_deg,
                    "translation_threshold_mm": args.translation_threshold_mm,
                    "symmetry_axes": {key: list(value) for key, value in SYM_AXES.items()},
                    "symmetry_step_deg": SYM_STEP,
                },
            },
            "references": ({
                "pseudo_gt": str(Path(args.pseudo_gt).resolve()),
                "pseudo_gt_sha256": sha256(args.pseudo_gt),
                "trajectory": str(Path(args.trajectory).resolve()),
                "trajectory_sha256": sha256(args.trajectory),
            } if args.pseudo_gt and args.trajectory else None),
            "outputs": {
                "detections": {"file": str(diagnostic_path.resolve()),
                               "sha256": sha256(diagnostic_path), "rows": detection_count},
                "frames": {"file": str(frame_path.resolve()),
                           "sha256": sha256(frame_path), "rows": len(run_frames)},
                **({"pem_score_analysis": {
                    "file": str(score_path.resolve()), "sha256": sha256(score_path),
                    "rows": score_count,
                    "selection_method": "geometry_only",
                    "thresholds_active": False,
                }} if score_analysis_enabled else {}),
            },
        }
        provenance_path.write_text(
            json.dumps(provenance, ensure_ascii=False, indent=2) + "\n",
            encoding="utf-8")
        print(f"[run] {name}: 검출 {detection_count} → {out / (name + '.jsonl')}",
              flush=True)


# ----------------------------------------------------------------- 채점
def load(p):
    by = defaultdict(dict)
    for l in open(p, encoding="utf-8"):
        r = json.loads(l)
        by[r["i"]][r["object"]] = r
    return by


def calibrate(runs, tol=30.0, min_n=20):
    """모든 설정을 합쳐 객체쌍 상대회전 R_ij = R_i^T R_j 를 최빈 군집으로 교정."""
    acc = defaultdict(list)
    for by in runs:
        for _i, objs in by.items():
            ns = sorted(objs)
            for a in range(len(ns)):
                for b in range(a + 1, len(ns)):
                    Ra = np.array(objs[ns[a]]["R"])
                    Rb = np.array(objs[ns[b]]["R"])
                    acc[(ns[a], ns[b])].append(Ra.T @ Rb)
    rel, share = {}, {}
    for k, v in acc.items():
        if len(v) < min_n:
            continue
        # 두 물체 중 하나라도 대칭이면 상대회전도 그 대칭만큼 애매하다 → 둘 다 접는다
        M, sh = mode_cluster(v, tol)
        rel[k] = M
        share[k] = (sh, len(v))
    return rel, share


def reference(objs, target, rel, tol=30.0):
    """자기 자신을 뺀 나머지 객체로 target 의 자세를 예측. (기준, 파트너수)."""
    preds = []
    for p, r in objs.items():
        if p == target:
            continue
        Rp = np.array(r["R"])
        if (p, target) in rel:
            preds.append(Rp @ rel[(p, target)])
        elif (target, p) in rel:
            preds.append(Rp @ rel[(target, p)].T)
    if len(preds) < 2:
        return None, len(preds)
    # 서로 30° 안에서 뭉치는 최대 집합만 채택
    best = []
    for i, A in enumerate(preds):
        grp = [B for B in preds if ang_deg(A, B, target) < tol]
        if len(grp) > len(best):
            best = grp
    if len(best) < 2:
        return None, len(preds)
    return rot_mean(best), len(best)


def report(args):
    names = args.settings.split(",")
    runs = {n: load(Path(args.out) / f"{n}.jsonl") for n in names}
    rel, share = calibrate(list(runs.values()))
    print(f"[교정] 객체쌍 {len(rel)}쌍")
    for k in sorted(share, key=lambda k: -share[k][1])[:8]:
        print(f"    {k[0]:24s} {k[1]:24s} 최빈군집 {share[k][0]*100:5.1f}%  n={share[k][1]}")

    err = {n: {} for n in names}
    for n in names:
        for i, objs in runs[n].items():
            for o in objs:
                # 기준은 **OFF 설정의 파트너 자세**로 세운다 — 설정마다 기준이 흔들리면
                # 비교가 안 된다. 대상 물체 자신은 그 설정의 값을 쓴다.
                base = runs[names[0]].get(i, {})
                part = {k: v for k, v in base.items() if k != o}
                if len(part) < 2:
                    continue
                ref, npart = reference({**part, o: objs[o]}, o, rel)
                if ref is None:
                    continue
                err[n][(i, o)] = (ang_deg(ref, np.array(objs[o]["R"]), o), npart,
                                  objs[o].get("verify"))
    print()
    print(f"{'설정':6s} {'평가건수':>7s} {'중앙°':>7s} {'<15°':>7s} {'>45°(gross)':>12s}")
    for n in names:
        e = [v[0] for v in err[n].values()]
        if not e:
            print(f"{n:6s}  (평가 가능한 건이 없다)")
            continue
        e = np.array(e)
        print(f"{n:6s} {len(e):7d} {np.median(e):7.1f} {100*(e<15).mean():6.1f}% "
              f"{100*(e>45).mean():11.1f}%")

    base = names[0]
    for n in names[1:]:
        com = set(err[base]) & set(err[n])
        fix = sum(1 for k in com if err[base][k][0] > 45 and err[n][k][0] <= 45)
        brk = sum(1 for k in com if err[base][k][0] <= 45 and err[n][k][0] > 45)
        chg = sum(1 for k in com if abs(err[base][k][0] - err[n][k][0]) > 1e-6)
        gross0 = sum(1 for k in com if err[base][k][0] > 45)
        print(f"\n[{base} -> {n}] 공통 {len(com)}건 · 답이 바뀐 비율 {100*chg/max(len(com),1):.1f}%"
              f" · 뒤집힘 교정 {fix} : 파손 {brk}"
              f" (기준 뒤집힘 {gross0}건 중 {100*fix/max(gross0,1):.0f}% 회복)")

    for n in names[1:]:
        vd = defaultdict(list)
        for k, v in err[n].items():
            if v[2]:
                vd[v[2]["verdict"]].append(v[0])
        if not vd:
            continue
        print(f"\n[{n}] 판정별 실제 오차")
        for k in ("PASS", "CORRECTED", "AMBIGUOUS"):
            if k not in vd:
                continue
            a = np.array(vd[k])
            print(f"    {k:10s} n={len(a):4d}  중앙 {np.median(a):5.1f}°  "
                  f"<15° {100*(a<15).mean():5.1f}%  >45° {100*(a>45).mean():5.1f}%")
        conf = [(err[n][k][2]["conf"], err[n][k][0]) for k in err[n] if err[n][k][2]]
        if conf:
            conf.sort()
            print(f"    신뢰도 구간별 gross:", end=" ")
            for lo, hi in ((0.0, .55), (.55, .7), (.7, .85), (.85, 1.01)):
                s = [e for c, e in conf if lo <= c < hi]
                if s:
                    print(f"[{lo:.2f},{hi:.2f}) {100*np.mean(np.array(s) > 45):.0f}%"
                          f"(n={len(s)})", end="  ")
            print()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--bag", default="")
    ap.add_argument("--out", default="temp/verify_eval")
    ap.add_argument("--config", default="configs/yolo_ism_objects.yaml")
    ap.add_argument("--device", default="cuda:0")
    ap.add_argument("--stride", type=int, default=7)
    ap.add_argument("--limit", type=int, default=0)
    ap.add_argument("--settings", default="off,w0,on")
    ap.add_argument("--select-rejections-from", default="",
                    help="frames.jsonl에서 입력 탈락이 있었던 원본 프레임만 같은 index/seed로 재실행")
    ap.add_argument("--pem-diagnostic-topn", type=int, default=0,
                    help="0이면 계측 끔; 양수면 상위 N 후보의 점 단위 근거를 저장")
    ap.add_argument("--pem-diagnostic-stride", type=int, default=8,
                    help="점 단위 근거의 관측점 축약 간격")
    ap.add_argument("--pem-score-analysis", action="store_true",
                    help="6000 residual 집계와 300개 전체 독립 점수 compact artifact 저장")
    ap.add_argument("--rotation-threshold-deg", type=float, default=30.0)
    ap.add_argument("--translation-threshold-mm", type=float, default=100.0)
    ap.add_argument("--pseudo-gt", default="",
                    help="trusted SLAM map pseudo-GT JSON; --trajectory와 함께 쓰면 6000/300 OX 계측")
    ap.add_argument("--trajectory", default="", help="T_wc trajectory txt")
    ap.add_argument("--dataset-manifest", default="",
                    help="optional spelling of the required in-bag dataset_manifest.json")
    ap.add_argument("--report", action="store_true", help="이미 만든 jsonl 로 채점만")
    ap.add_argument("--skip-summary-report", action="store_true",
                    help="대용량 진단 생성 후 메모리 집약적인 legacy 요약 채점을 건너뜀")
    a = ap.parse_args()
    if not a.report:
        if not a.bag:
            raise SystemExit("--bag 이 필요하다")
        run(a)
    if not a.skip_summary_report:
        report(a)


if __name__ == "__main__":
    main()
